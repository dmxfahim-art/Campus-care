---
import '../styles/global.css';
import { storeScript } from '../lib/store';
import { adminScript } from '../lib/admin-script';
import { studentScript } from '../lib/student-script';
const { title = 'CampusCare' } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/campuscare-mark.svg" />
    <title>{title}</title>
    <script is:inline set:html={storeScript}></script>
    <script is:inline set:html={adminScript}></script>
    <script is:inline set:html={studentScript}></script>
    <script is:inline>
      (async () => {
        const path = location.pathname;
        if (['/login', '/register', '/admin/login'].includes(path)) return;
        let user;
        try { user = (await CampusAdmin.request('/auth/me')).user; CampusCare.saveState({ user, mode: 'api' }); }
        catch { CampusCare.saveState({ user: null }); location.replace(path.startsWith('/admin') ? '/admin/login' : '/login'); return; }
        if (path.startsWith('/admin')) {
          if (!['admin', 'staff'].includes(user.role)) location.replace('/login');
          else if (['/admin/team', '/admin/support'].includes(path) && user.role !== 'admin') location.replace('/admin');
        } else if (user.role !== 'student') location.replace('/admin');
      })();
    </script>
  </head>
  <body><slot /></body>
</html>
