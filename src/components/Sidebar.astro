---
const path = Astro.url.pathname;
const active = Astro.props.active || (path === '/' ? 'overview' : path === '/complaint' ? 'complaints' : path.slice(1));
---
<aside class="sidebar">
  <a class="brand" href="/"><span class="brand-mark">✦</span><span>Campus<span>Care</span></span></a>
  <div class="workspace-label">STUDENT PORTAL</div>
  <nav aria-label="Main navigation">
    <a class={`nav-item ${active === 'overview' ? 'active' : ''}`} href="/"><span>⌂</span> Overview</a>
    <a class={`nav-item ${active === 'complaints' ? 'active' : ''}`} href="/complaints"><span>▤</span> My complaints <b data-complaint-count>0</b></a>
    <a class={`nav-item ${active === 'report' ? 'active' : ''}`} href="/report"><span>＋</span> New complaint</a>
    <a class={`nav-item ${active === 'notifications' ? 'active' : ''}`} href="/notifications"><span>♧</span> Notifications</a>
  </nav>
  <div class="sidebar-bottom">
    <a class={`nav-item ${active === 'help' ? 'active' : ''}`} href="/help"><span>?</span> Help & support</a>
    <div class="account-card">
      <div class="account-identity"><div class="avatar" data-user-avatar></div><div class="account-copy"><strong data-user-name></strong><small data-user-meta></small></div></div>
      <div class="account-actions"><a class={active === 'profile' ? 'active' : ''} href="/profile">Profile</a><button type="button" data-sign-out>Sign out</button></div>
    </div>
  </div>
</aside>
<script is:inline>
  queueMicrotask(() => {
    const state = CampusCare.getState(), user = state.user;
    if (!user) return;
    const sidebar = document.querySelector('.sidebar');
    sidebar.querySelector('[data-user-name]').textContent = user.name;
    sidebar.querySelector('[data-user-meta]').textContent = `${user.role} · ${user.id}`;
    sidebar.querySelector('[data-user-avatar]').textContent = user.name.trim().split(/\s+/).map(part => part[0]).slice(0, 2).join('').toUpperCase();
    sidebar.querySelector('[data-complaint-count]').textContent = state.complaints.filter(c => user.role !== 'student' || c.student === user.name).length;
    sidebar.querySelector('[data-sign-out]').addEventListener('click', () => CampusCare.logout());
  });
</script>
