---
import Brand from './Brand.astro';
const active = Astro.props.active;
---
<aside class="sidebar">
  <Brand light />
  <div class="workspace-label">ADMIN PORTAL</div>
  <nav aria-label="Admin navigation">
    <a class={`nav-item ${active === 'overview' ? 'active' : ''}`} href="/admin"><span>⌂</span> Overview</a>
    <a class={`nav-item ${active === 'complaints' ? 'active' : ''}`} href="/admin/complaints"><span>▤</span> Complaints</a>
    <a class={`nav-item ${active === 'team' ? 'active' : ''}`} href="/admin/team" data-admin-only><span>♙</span> Team</a>
    <a class={`nav-item ${active === 'support' ? 'active' : ''}`} href="/admin/support" data-admin-only><span>✉</span> Support</a>
  </nav>
  <div class="sidebar-bottom"><div class="account-card"><div class="account-identity"><div class="avatar" data-admin-avatar></div><div class="account-copy"><strong data-admin-name></strong><small data-admin-role></small></div></div><div class="account-actions"><a href="/admin/profile">Profile</a><button type="button" data-admin-logout>Sign out</button></div></div></div>
</aside>
<script is:inline>
  queueMicrotask(() => {
    const user = CampusCare.getState().user;
    if (!user) return;
    document.querySelector('[data-admin-name]').textContent = user.name;
    document.querySelector('[data-admin-role]').textContent = user.role === 'admin' ? 'Administrator' : 'Department staff';
    if (user.role !== 'admin') document.querySelectorAll('[data-admin-only]').forEach(link => link.hidden = true);
    document.querySelector('[data-admin-avatar]').textContent = user.name.trim().split(/\s+/).map(x => x[0]).slice(0,2).join('').toUpperCase();
    document.querySelector('[data-admin-logout]').onclick = () => CampusCare.logout();
  });
</script>
