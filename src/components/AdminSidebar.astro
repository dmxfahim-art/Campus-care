---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
const active = Astro.props.active;
---
<aside class="sidebar">
  <Brand light />
  <div class="workspace-label">ADMIN PORTAL</div>
  <nav aria-label="Main navigation">
    <a class={`nav-item ${active === 'overview' ? 'active' : ''}`} href="/admin"><Icon name="layout-dashboard" size={18} /> Overview</a>
    <a class={`nav-item ${active === 'complaints' ? 'active' : ''}`} href="/admin/complaints"><Icon name="file-text" size={18} /> Complaints</a>
    <a class={`nav-item ${active === 'categories' ? 'active' : ''}`} href="/admin/categories" data-admin-only><Icon name="tag" size={18} /> Categories</a>
    <a class={`nav-item ${active === 'team' ? 'active' : ''}`} href="/admin/team" data-admin-only><Icon name="users" size={18} /> Team</a>
  </nav>
  <div class="sidebar-bottom">
    <div class="account-card">
      <div class="account-identity">
        <div class="avatar" data-admin-avatar></div>
        <div class="account-copy">
          <strong data-admin-name></strong>
          <small data-admin-role></small>
        </div>
      </div>
      <div class="account-actions">
        <a href="/admin/profile">Profile</a>
        <button type="button" data-admin-logout>Sign out</button>
      </div>
    </div>
  </div>
</aside>
<script is:inline>
  (async () => {
    let user = CampusCare.getUser();
    if (!user) user = await CampusCare.fetchUser();
    if (user) CampusCare.applyUserToDom(user);
    const logoutBtn = document.querySelector('[data-admin-logout]');
    if (logoutBtn) logoutBtn.onclick = () => CampusCare.logout();
  })();
</script>
