---
import AppLayout from '../layouts/AppLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Icon from '../components/Icon.astro';
---
<AppLayout title="Overview — CampusCare">
  <div class="app-shell">
    <Sidebar active="overview" />
    <main class="main-content">
      <header class="topbar">
        <div class="breadcrumb"><span>Student portal</span><b>/</b> Overview</div>
        <a class="top-notification" href="/notifications" aria-label="View notifications"><Icon name="bell" size={16} /> <span id="unread-count"></span></a>
      </header>
      <section class="page-content">
        <div class="welcome-row">
          <div><p class="eyebrow" id="today-label"></p><h1>Good morning, <span id="welcome-name"></span></h1><p class="subtitle">Keep an eye on your reports. We’ll let you know as soon as something changes.</p></div>
          <a class="primary-button" href="/report"><Icon name="plus" size={16} /> Report a problem</a>
        </div>
        <div class="stats-grid">
          <article class="stat-card"><div class="stat-icon blue"><Icon name="file-text" size={24} /></div><div><span>Total complaints</span><strong id="total-count">0</strong><small>All reports</small></div></article>
          <article class="stat-card"><div class="stat-icon amber"><Icon name="clock" size={24} /></div><div><span>In progress</span><strong id="progress-count">0</strong><small>Being reviewed</small></div></article>
          <article class="stat-card"><div class="stat-icon green"><Icon name="check-circle-2" size={24} /></div><div><span>Resolved</span><strong id="resolved-count">0</strong><small>Completed reports</small></div></article>
        </div>
        <div class="section-heading"><div><h2>Recent complaints</h2><p>Your latest reports and their current status.</p></div><a href="/complaints">View all</a></div>
        <div class="complaints-card" id="dashboard-complaints"></div>
        <div class="bottom-grid">
          <section class="tip-card"><div class="tip-illustration"><Icon name="sparkles" size={24} /></div><div><p class="eyebrow">QUICK ACTION</p><h3>Something not right?</h3><p>Tell us what’s happening and we’ll get it to the right team.</p><a class="text-button" href="/report">Submit a complaint</a></div></section>
          <section class="notice-card"><div class="notice-head"><h2>Latest update</h2><a href="/notifications">All notifications</a></div><div class="notice-body" id="latest-notice"></div></section>
        </div>
      </section>
    </main>
  </div>
  <script is:inline>
    document.querySelector('#dashboard-complaints').innerHTML = CampusCare.loaderHtml('Loading recent complaints...');
    document.querySelector('#latest-notice').innerHTML = CampusCare.loaderHtml('Loading latest update...');
    (async () => {
      try {
        const homeState = await CampusStudent.session();
        const user = homeState.user, items = await CampusStudent.complaints(), notifications = await CampusStudent.notifications();
        document.querySelector('#welcome-name').textContent = user.name.split(/\s+/)[0];
        document.querySelector('#today-label').textContent = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }).toUpperCase();
        document.querySelector('#total-count').textContent = items.length;
        document.querySelector('#progress-count').textContent = items.filter(c => c.status === 'In Progress').length;
        document.querySelector('#resolved-count').textContent = items.filter(c => c.status === 'Resolved').length;
        document.querySelector('#unread-count').textContent = notifications.filter(n => !n.read).length || '';
        const escape = CampusCare.escapeHtml;
        document.querySelector('#dashboard-complaints').innerHTML = '<div class="table-head"><span>Complaint</span><span>Category</span><span>Status</span><span>Submitted</span></div>' + (items.slice(0, 5).map(c => `<a class="complaint-link" href="/complaint?id=${encodeURIComponent(c.id)}"><div class="table-row"><div class="complaint-name"><div class="complaint-icon">${CampusCare.icon('file-text', { size: 18 })}</div><div><strong>${escape(c.title)}</strong><small>${escape(c.displayId)} · ${escape(c.location)}</small></div></div><span class="category">${escape(c.category)}</span><span class="status ${c.status.toLowerCase().replace(' ', '-')}"><i></i>${escape(c.status)}</span><span class="date">${escape(c.createdAt)}</span></div></a>`).join('') || '<p class="empty-state">No complaints yet. Report a problem to get started.</p>');
        const note = notifications[0];
        document.querySelector('#latest-notice').innerHTML = note ? `<div class="notice-dot">${note.read ? CampusCare.icon('check', { size: 14 }) : CampusCare.icon('circle', { size: 10 })}</div><div><strong>${escape(note.text)}</strong><p>${escape(note.time)}</p><a href="/notifications">Open notifications</a></div>` : '<p>No notifications yet.</p>';
      } catch (error) {
        document.querySelector('#dashboard-complaints').innerHTML = '<p class="form-error">' + CampusCare.escapeHtml(error.message) + '</p>';
      }
    })();
  </script>
</AppLayout>
