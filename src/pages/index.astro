---
import '../styles/global.css';
import { storeScript } from '../lib/store';

const complaints = [
  { id: 'CC-1048', title: 'Wi-Fi not working in Lab 3', category: 'IT', status: 'In Progress', date: 'Today' },
  { id: 'CC-1039', title: 'Broken chair in Room 204', category: 'Classroom', status: 'Resolved', date: 'Oct 28' },
  { id: 'CC-1027', title: 'Bus arriving late on Route B', category: 'Transport', status: 'Submitted', date: 'Oct 25' },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>CampusCare — Student dashboard</title>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar">
        <a class="brand" href="/" aria-label="CampusCare home">
          <span class="brand-mark">✦</span>
          <span>Campus<span>Care</span></span>
        </a>
        <div class="workspace-label">STUDENT PORTAL</div>
        <nav aria-label="Main navigation">
          <a class="nav-item active" href="/"><span>⌂</span> Overview</a>
          <a class="nav-item" href="/complaints"><span>▤</span> My complaints <b id="sidebar-count">3</b></a>
          <a class="nav-item" href="/report"><span>＋</span> New complaint</a>
          <a class="nav-item" href="/notifications"><span>♧</span> Notifications <i></i></a>
        </nav>
        <div class="sidebar-bottom">
          <a class="nav-item" href="/help"><span>?</span> Help & support</a>
          <div class="account-card">
            <div class="account-identity"><div class="avatar" id="home-avatar"></div><div class="account-copy"><strong id="home-name"></strong><small id="home-meta"></small></div></div>
            <div class="account-actions"><a href="/profile">Profile</a><button type="button" id="home-sign-out">Sign out</button></div>
          </div>
        </div>
      </aside>

      <main class="main-content">
        <header class="topbar">
          <div class="breadcrumb"><span>Student portal</span><b>/</b> Overview</div>
          <div class="top-actions"><a class="icon-button" href="/notifications" aria-label="Notifications">♧<i></i></a><div class="top-avatar" id="home-top-avatar"></div></div>
        </header>

        <section class="page-content">
          <div class="welcome-row">
            <div><p class="eyebrow" id="today-label"></p><h1>Good morning, <span id="welcome-name">Tasnim</span> ✦</h1><p class="subtitle">Keep an eye on your reports. We’ll let you know as soon as something changes.</p></div>
            <a class="primary-button" href="/report"><span>＋</span> Report a problem</a>
          </div>

          <div class="stats-grid">
            <article class="stat-card"><div class="stat-icon blue">▤</div><div><span>Total complaints</span><strong id="total-count">0</strong><small class="positive">All reports</small></div></article>
            <article class="stat-card"><div class="stat-icon amber">◷</div><div><span>In progress</span><strong id="progress-count">0</strong><small>Being reviewed now</small></div></article>
            <article class="stat-card"><div class="stat-icon green">✓</div><div><span>Resolved</span><strong id="resolved-count">0</strong><small class="positive">Completed reports</small></div></article>
          </div>

          <div class="section-heading" id="complaints"><div><h2>Recent complaints</h2><p>Your latest reports and their current status.</p></div><a href="/complaints">View all <span>→</span></a></div>
          <div class="complaints-card" id="dashboard-complaints">
            <div class="table-head"><span>Complaint</span><span>Category</span><span>Status</span><span>Submitted</span><span></span></div>
            {complaints.map((complaint) => <div class="table-row"><div class="complaint-name"><div class="complaint-icon">{complaint.category === 'IT' ? '⌁' : complaint.category === 'Transport' ? '⌕' : '▧'}</div><div><strong>{complaint.title}</strong><small>{complaint.id}</small></div></div><span class="category">{complaint.category}</span><span class={`status ${complaint.status.toLowerCase().replace(' ', '-')}`}><i></i>{complaint.status}</span><span class="date">{complaint.date}</span><button class="row-menu" aria-label={`More options for ${complaint.title}`}>•••</button></div>)}
          </div>

          <div class="bottom-grid">
            <section class="tip-card" id="new-complaint"><div class="tip-illustration">✦</div><div><span class="eyebrow">QUICK ACTION</span><h3>Something not right?</h3><p>Tell us what’s happening and we’ll get it to the right team.</p><a class="text-button" href="/report">Submit a complaint <span>→</span></a></div></section>
            <section class="notice-card" id="notifications"><div class="notice-head"><h2>Latest update</h2><span>2h ago</span></div><div class="notice-body"><div class="notice-dot">✓</div><div><strong>Your complaint was assigned</strong><p><b>Wi-Fi not working in Lab 3</b> was sent to the IT Department.</p><a href="#complaint">View complaint →</a></div></div></section>
          </div>
        </section>
      </main>
    </div>
  <script is:inline set:html={storeScript}></script>
  <script is:inline>
    const state=CampusCare.getState();if(!state.user||!state.users.some(u=>u.id===state.user.id&&u.email===state.user.email)){state.user=null;CampusCare.saveState(state);location.replace('/login')}
    const items=state.complaints.filter(c=>c.student===state.user?.name);
    document.querySelector('#welcome-name').textContent=state.user?.name.split(' ')[0]||'Student';
    document.querySelector('#home-name').textContent=state.user.name;document.querySelector('#home-meta').textContent=state.user.role+' · '+state.user.id;const initials=state.user.name.split(/\s+/).map(s=>s[0]).slice(0,2).join('').toUpperCase();document.querySelector('#home-avatar').textContent=initials;document.querySelector('#home-top-avatar').textContent=initials;
    document.querySelector('#home-sign-out').addEventListener('click',()=>CampusCare.logout());
    document.querySelector('#today-label').textContent=new Date().toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric'}).toUpperCase();
    document.querySelector('#total-count').textContent=items.length;document.querySelector('#sidebar-count').textContent=items.length;
    document.querySelector('#progress-count').textContent=items.filter(c=>c.status==='In Progress').length;
    document.querySelector('#resolved-count').textContent=items.filter(c=>c.status==='Resolved').length;
    document.querySelector('#dashboard-complaints').innerHTML='<div class="table-head"><span>Complaint</span><span>Category</span><span>Status</span><span>Submitted</span><span></span></div>'+items.slice(0,5).map(c=>`<a class="complaint-link" href="/complaint?id=${encodeURIComponent(c.id)}"><div class="table-row"><div class="complaint-name"><strong>${CampusCare.escapeHtml(c.title)}</strong></div><span>${CampusCare.escapeHtml(c.category)}</span><span>${CampusCare.escapeHtml(c.status)}</span><span>${CampusCare.escapeHtml(c.createdAt)}</span><span>→</span></div></a>`).join('');
    const note=state.notifications[0];document.querySelector('#notifications .notice-body').innerHTML=note?`<div class="notice-dot">${note.read?'✓':'●'}</div><div><strong>${CampusCare.escapeHtml(note.text)}</strong><p>${CampusCare.escapeHtml(note.time)}</p><a href="/notifications">View notifications →</a></div>`:'<p>No notifications yet.</p>';document.querySelector('#notifications .notice-head span').textContent=note?.time||'';
  </script>
  </body>
</html>
<script is:inline>
  function scrollToHash() {
    if (location.hash === '#notifications') {
      const target = document.getElementById('notifications');
      if (target) setTimeout(() => target.scrollIntoView({ behavior: 'smooth', block: 'start' }), 50);
    }
  }
  window.addEventListener('load', scrollToHash);
  window.addEventListener('hashchange', scrollToHash);
  scrollToHash();
</script>
