---
import AppLayout from '../layouts/AppLayout.astro'; import Sidebar from '../components/Sidebar.astro';
---
<AppLayout title="My complaints — CampusCare"><div class="app-shell"><Sidebar active="complaints" /><main class="main-content"><header class="topbar"><div class="breadcrumb"><span>Student portal</span><b>/</b> My complaints</div><div class="top-actions"><a class="primary-button" href="/report">＋ New complaint</a><div class="top-avatar" data-top-avatar></div></div></header><section class="page-content"><div class="welcome-row"><div><p class="eyebrow">YOUR REPORTS</p><h1>My complaints</h1><p class="subtitle">Follow every issue from submission to resolution.</p></div></div><div class="filter-bar"><button class="filter active" data-filter="All">All <b id="all-count">0</b></button><button class="filter" data-filter="Submitted">Submitted</button><button class="filter" data-filter="In Progress">In progress</button><button class="filter" data-filter="Resolved">Resolved</button></div><div class="complaints-card" id="complaints-list"></div><section class="notice-card notifications-panel" id="notifications"><div class="notice-head"><h2>Notifications</h2><a href="/notifications">Manage notifications →</a></div><div id="notification-list"></div></section></section></main></div><script is:inline>const list=document.querySelector('#complaints-list'),state=CampusCare.getState(),visible=state.complaints.filter(c=>state.user.role!=='student'||c.student===state.user.name);document.querySelector('#all-count').textContent=visible.length;document.querySelector('[data-top-avatar]').textContent=state.user.name.split(/\s+/).map(s=>s[0]).slice(0,2).join('').toUpperCase();function render(filter='All'){const items=visible.filter(c=>filter==='All'||c.status===filter);list.innerHTML=items.map(c=>`<a class="complaint-link" href="/complaint?id=${encodeURIComponent(c.id)}"><div class="table-row"><div class="complaint-name"><div class="complaint-icon">▤</div><div><strong>${CampusCare.escapeHtml(c.title)}</strong><small>${CampusCare.escapeHtml(c.id)} · ${CampusCare.escapeHtml(c.location)}</small></div></div><span class="category">${CampusCare.escapeHtml(c.category)}</span><span class="status ${c.status.toLowerCase().replace(' ','-')}"><i></i>${CampusCare.escapeHtml(c.status)}</span><span class="date">${CampusCare.escapeHtml(c.createdAt)}</span><span>→</span></div></a>`).join('')||'<div class="empty-state">No complaints in this view.</div>'}render();document.querySelectorAll('.filter').forEach(b=>b.onclick=()=>{document.querySelectorAll('.filter').forEach(x=>x.classList.remove('active'));b.classList.add('active');render(b.dataset.filter)});document.querySelector('#notification-list').innerHTML=state.notifications.map(n=>`<div class="notification-row"><div class="notice-dot">${n.read?'✓':'●'}</div><div><strong>${CampusCare.escapeHtml(n.text)}</strong><small>${CampusCare.escapeHtml(n.time)}</small></div></div>`).join('')||'<div class="empty-state">You are all caught up.</div>';</script></AppLayout>
