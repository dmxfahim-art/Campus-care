---
import AppLayout from '../layouts/AppLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Icon from '../components/Icon.astro';
---
<AppLayout title="Report a problem — CampusCare">
  <div class="app-shell">
    <Sidebar active="report" />
    <main class="main-content">
      <header class="topbar"><div class="breadcrumb"><span>Student portal</span><b>/</b> New complaint</div><div class="top-actions"><div class="top-avatar" id="report-avatar"></div></div></header>
      <section class="page-content form-page">
        <div class="welcome-row"><div><p class="eyebrow">HELP US IMPROVE CAMPUS</p><h1>Report a problem</h1><p class="subtitle">Give us a few details and we’ll send it to the right team.</p></div></div>
        <form id="report-form" class="form-card">
          <div class="form-section"><span class="step">01</span><div><h2>What’s happening?</h2><p>Be as specific as you can so the team can help faster.</p></div></div>
          <label>Title<input required name="title" placeholder="e.g. Projector not working in Room 204" /></label>
          <div class="form-grid"><label>Category<select required name="category" id="category-select"><option value="IT">IT</option><option value="Classroom">Classroom</option><option value="Transport">Transport</option><option value="Facilities">Facilities</option></select></label><label>Location<input required name="location" placeholder="e.g. Main library, floor 2" /></label></div>
          <label>Description<textarea required name="description" rows="5" placeholder="Tell us what you noticed, when it started, and anything else that may help..."></textarea></label>
          <p class="subtitle">Admins see the report. Leave out your name or other identifying details if you want to stay anonymous to them.</p>
          <div class="form-actions"><a href="/" class="secondary-button">Cancel</a><button class="primary-button" type="submit">Submit complaint <Icon name="arrow-right" size={16} /></button></div>
        </form>
      </section>
    </main>
  </div>
  <script is:inline>
    (async () => {
      try {
        const categories = await CampusStudent.categories();
        if (categories && categories.length) {
          const select = document.querySelector('#category-select');
          if (select) {
            select.innerHTML = categories.map(cat => `<option value="${CampusCare.escapeHtml(cat.code)}">${CampusCare.escapeHtml(cat.name)}</option>`).join('');
          }
        }
      } catch {}
    })();
    queueMicrotask(async () => {
      const user = CampusCare.getUser() || (await CampusCare.fetchUser());
      if (user) {
        document.querySelector('#report-avatar').textContent = user.name.trim().split(/\s+/).map(part => part[0]).slice(0, 2).join('').toUpperCase();
      }
    });
    const reportForm = document.querySelector('#report-form');
    const submitBtn = reportForm.querySelector('button[type="submit"]');
    reportForm.addEventListener('submit', async event => {
      event.preventDefault();
      CampusCare.setButtonLoading(submitBtn, true, 'Submitting complaint...');
      try {
        const id = await CampusStudent.report(new FormData(event.currentTarget));
        location.replace('/complaint?id=' + encodeURIComponent(id));
      } catch (error) {
        let message = document.querySelector('#report-error');
        if (!message) {
          message = document.createElement('p');
          message.id = 'report-error';
          message.className = 'form-error';
          event.currentTarget.append(message);
        }
        message.textContent = error.message;
        CampusCare.setButtonLoading(submitBtn, false);
      }
    });
  </script>
</AppLayout>
