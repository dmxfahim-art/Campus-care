---
import AppLayout from '../layouts/AppLayout.astro'; import Sidebar from '../components/Sidebar.astro';
---
<AppLayout title="Complaint details — CampusCare"><div class="app-shell"><Sidebar active="complaints"/><main class="main-content"><header class="topbar"><div class="breadcrumb"><a href="/complaints">My complaints</a><b>/</b> Details</div></header><section class="page-content detail-page"><a class="back-link" href="/complaints">← Back to complaints</a><div id="detail"></div></section></main></div><script is:inline>
const state=CampusCare.getState(),id=new URLSearchParams(location.search).get('id'),c=state.complaints.find(x=>x.id===id),root=document.querySelector('#detail');
if(!c){root.textContent='Complaint not found.'}else{root.innerHTML=`<p class="eyebrow">COMPLAINT ${CampusCare.escapeHtml(c.id)}</p><h1>${CampusCare.escapeHtml(c.title)}</h1><p class="subtitle">${CampusCare.escapeHtml(c.category)} · ${CampusCare.escapeHtml(c.location)}</p><div class="detail-grid"><article class="detail-card"><h2>Complaint timeline</h2><p>Submitted: ${CampusCare.escapeHtml(c.createdAt)}</p><p>Current status: <strong>${CampusCare.escapeHtml(c.status)}</strong></p><p>Last updated: ${CampusCare.escapeHtml(c.updatedAt)}</p><p>${CampusCare.escapeHtml(c.description)}</p></article><aside class="detail-card"><h2>Department & feedback</h2><p>${CampusCare.escapeHtml(c.department)}</p><div id="status-area"></div><div id="feedback-area"></div></aside></div>`;const status=document.querySelector('#status-area');if(state.user.role!=='student'){status.innerHTML='<label>Status <select id="status-select"><option>Submitted</option><option>In Progress</option><option>Resolved</option></select></label><button class="secondary-button" id="save-status">Save status</button>';document.querySelector('#status-select').value=c.status;document.querySelector('#save-status').onclick=()=>{const next=document.querySelector('#status-select').value;if(next===c.status)return;c.status=next;c.updatedAt=new Date().toISOString().slice(0,10);state.notifications.unshift({id:Date.now(),text:c.id+' changed to '+next,read:false,time:'Just now'});CampusCare.saveState(state);location.reload()}}const feedback=document.querySelector('#feedback-area');if(c.status==='Resolved'&&state.user.role==='student'){feedback.innerHTML='<form id="feedback-form"><h3>How did we do?</h3><label>Rating <select name="rating"><option value="5">5</option><option value="4">4</option><option value="3">3</option><option value="2">2</option><option value="1">1</option></select></label><label>Comment <textarea name="comment" required></textarea></label><button class="secondary-button">Save feedback</button></form>';document.querySelector('#feedback-form').onsubmit=e=>{e.preventDefault();const f=new FormData(e.currentTarget);c.feedback={rating:Number(f.get('rating')),comment:String(f.get('comment'))};CampusCare.saveState(state);feedback.textContent='Feedback saved.'}}}
</script></AppLayout>
