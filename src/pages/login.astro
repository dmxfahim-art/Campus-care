---
import AppLayout from '../layouts/AppLayout.astro';
import Brand from '../components/Brand.astro';
---
<AppLayout title="Sign in — CampusCare">
  <main class="auth-page">
    <div class="auth-brand"><Brand /></div>
    <section class="auth-card">
      <p class="eyebrow">WELCOME BACK</p>
      <h1>Welcome to CampusCare</h1>
      <p class="auth-subtitle">A simpler way to make campus better, together.</p>
      <form id="login-form">
        <label>Email<input name="email" type="email" autocomplete="email" required placeholder="you@university.edu" /></label>
        <label>Password<input name="password" type="password" autocomplete="current-password" required placeholder="Enter your password" /></label>
        <p class="form-error" id="error" role="alert"></p>
        <button class="primary-button" type="submit">Sign in</button>
      </form>
      <p class="auth-footer">New to CampusCare? <a href="/register">Create an account</a></p>
      <p class="auth-footer"><a href="/admin/login">Admin sign in →</a></p>
    </section>
  </main>
  <script is:inline>
    document.querySelector('#login-form').addEventListener('submit', async event => {
      event.preventDefault();
      const state = CampusCare.getState(), values = new FormData(event.currentTarget);
      const email = String(values.get('email')).trim().toLowerCase(), password = String(values.get('password'));
      const error=document.querySelector('#error');error.textContent='';
      try {
        if (await CampusStudent.backendReady()) {
          const data=await CampusAdmin.request('/auth/login','POST',{email,password});
          if(data.user.role!=='student'){await CampusAdmin.request('/auth/logout','POST');throw Error('Use the admin and staff sign in page.')}
          state.user=data.user;state.mode='api';
        } else throw Error('The database is not configured yet.');
        CampusCare.saveState(state);location.href='/';
      } catch (cause) {error.textContent=cause.message||'Sign in failed.'}
    });
  </script>
</AppLayout>
