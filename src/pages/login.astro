---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Sign in — CampusCare"><main class="auth-page"><div class="auth-brand"><span class="brand-mark">✦</span> Campus<span>Care</span></div><section class="auth-card"><p class="eyebrow">WELCOME BACK</p><h1>Sign in to CampusCare</h1><p class="auth-subtitle">Track your complaints and stay connected to campus.</p><form id="login-form"><label>Email<input name="email" type="email" required value="tasnim@example.com" /></label><label>Password<input name="password" type="password" required placeholder="Minimum 6 characters" /></label><div class="form-error" id="error"></div><button class="primary-button" type="submit">Sign in →</button></form><p class="auth-footer">New to CampusCare? <a href="/register">Create an account</a></p></section></main><script is:inline>document.querySelector('#login-form').addEventListener('submit',e=>{e.preventDefault();const state=CampusCare.getState(),f=new FormData(e.currentTarget),email=String(f.get('email')).toLowerCase(),password=String(f.get('password')),user=state.users.find(u=>u.email.toLowerCase()===email&&u.password===password);if(!user){document.querySelector('#error').textContent='Incorrect email or password.';return}state.user=user;CampusCare.saveState(state);location.href='/'});</script></AppLayout>
