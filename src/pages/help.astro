---
import AppLayout from '../layouts/AppLayout.astro'; import Sidebar from '../components/Sidebar.astro';
---
<AppLayout title="Help & support — CampusCare"><div class="app-shell"><Sidebar active="help"/><main class="main-content"><header class="topbar"><div class="breadcrumb"><span>Student portal</span><b>/</b> Help & support</div></header><section class="page-content form-page"><h1>Help & support</h1><div class="help-grid"><article class="detail-card"><h2>Submit a complaint</h2><p>Describe the issue, select a category and add its location.</p></article><article class="detail-card"><h2>Track progress</h2><p>Open My complaints to see status updates.</p></article></div><form class="form-card" id="help-form"><h2>Contact support</h2><label>Subject<input name="subject" required/></label><label>Message<textarea name="message" required rows="5"></textarea></label><button class="primary-button">Send request</button><p id="help-result" role="status"></p></form><h2>My support requests</h2><div id="help-history"></div></section></main></div><script is:inline>
  const history=document.querySelector('#help-history'),escape=CampusCare.escapeHtml;
  async function render(){try{const items=await CampusStudent.support();history.innerHTML=items.map(r=>`<div class="detail-card"><strong>${escape(r.subject)}</strong><p>${escape(r.message)}</p><small>${escape(String(r.createdAt).slice(0,10))} · ${escape(r.status||'Open')}</small>${r.reply?`<p><strong>Support reply:</strong> ${escape(r.reply)}</p>`:''}</div>`).join('')||'<p>No requests yet.</p>'}catch(error){history.innerHTML='<p class="form-error">'+escape(error.message)+'</p>'}}
  document.querySelector('#help-form').onsubmit=async e=>{e.preventDefault();const form=e.currentTarget,button=form.querySelector('button'),f=new FormData(form),result=document.querySelector('#help-result');button.disabled=true;result.textContent='Sending…';try{await CampusStudent.sendSupport(String(f.get('subject')).trim(),String(f.get('message')).trim());form.reset();result.textContent='Request sent. Our team will review it.';await render()}catch(error){result.textContent=error.message}finally{button.disabled=false}};render();
</script></AppLayout>
