---
import AppLayout from '../layouts/AppLayout.astro';
import Sidebar from '../components/Sidebar.astro';
---
<AppLayout title="Help & FAQs — CampusCare">
  <div class="app-shell">
    <Sidebar active="help" />
    <main class="main-content">
      <header class="topbar">
        <div class="breadcrumb"><span>Student portal</span><b>/</b> Help</div>
      </header>
      <section class="page-content form-page">
        <p class="eyebrow">HELP & GUIDANCE</p>
        <h1>Help Center</h1>
        <p class="subtitle">Quick guides and answers to common questions about using CampusCare.</p>
        <div class="help-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px; margin-top: 28px;">
          <article class="detail-card" style="padding: 24px;">
            <h2 style="font-size: 1.25rem; margin-bottom: 8px;">Submitting a complaint</h2>
            <p style="color: var(--muted); margin: 0;">Navigate to "New complaint", choose the appropriate category, specify the location, and describe the issue in detail. You can also upload a photo attachment.</p>
          </article>
          <article class="detail-card" style="padding: 24px;">
            <h2 style="font-size: 1.25rem; margin-bottom: 8px;">Tracking progress</h2>
            <p style="color: var(--muted); margin: 0;">View real-time status updates under "My complaints". Each report shows its assigned department and timeline of actions taken.</p>
          </article>
          <article class="detail-card" style="padding: 24px;">
            <h2 style="font-size: 1.25rem; margin-bottom: 8px;">Providing feedback</h2>
            <p style="color: var(--muted); margin: 0;">Once a complaint is resolved, you can rate the resolution and leave feedback to help improve university services.</p>
          </article>
          <article class="detail-card" style="padding: 24px;">
            <h2 style="font-size: 1.25rem; margin-bottom: 8px;">Notifications</h2>
            <p style="color: var(--muted); margin: 0;">Check your notifications tab for instant alerts whenever the status or assignment of your submitted complaints changes.</p>
          </article>
        </div>
      </section>
    </main>
  </div>
</AppLayout>
