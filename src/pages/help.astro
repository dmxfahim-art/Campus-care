---
import AppLayout from '../layouts/AppLayout.astro'; import Sidebar from '../components/Sidebar.astro';
---
<AppLayout title="Help & support — CampusCare"><div class="app-shell"><Sidebar active="help"/><main class="main-content"><header class="topbar"><div class="breadcrumb"><span>Student portal</span><b>/</b> Help & support</div></header><section class="page-content form-page"><h1>Help & support</h1><div class="help-grid"><article class="detail-card"><h2>Submit a complaint</h2><p>Describe the issue, select a category and add its location.</p></article><article class="detail-card"><h2>Track progress</h2><p>Open My complaints to see status updates.</p></article></div><form class="form-card" id="help-form"><h2>Contact support</h2><label>Subject<input name="subject" required/></label><label>Message<textarea name="message" required rows="5"></textarea></label><button class="primary-button">Send request</button><p id="help-result" role="status"></p></form><h2>My support requests</h2><div id="help-history"></div></section></main></div><script is:inline>const state=CampusCare.getState(),history=document.querySelector('#help-history');function render(){history.innerHTML=(state.supportRequests||[]).filter(r=>r.userId===state.user.id).map(r=>`<div class="detail-card"><strong>${CampusCare.escapeHtml(r.subject)}</strong><p>${CampusCare.escapeHtml(r.message)}</p><small>${CampusCare.escapeHtml(r.createdAt)}</small></div>`).join('')||'<p>No requests yet.</p>'}document.querySelector('#help-form').onsubmit=e=>{e.preventDefault();const f=new FormData(e.currentTarget);state.supportRequests ||= [];state.supportRequests.unshift({id:Date.now(),userId:state.user.id,subject:String(f.get('subject')),message:String(f.get('message')),createdAt:new Date().toISOString()});CampusCare.saveState(state);e.currentTarget.reset();document.querySelector('#help-result').textContent='Request saved. Our team will review it.';render()};render();</script></AppLayout>
