---
import AppLayout from '../layouts/AppLayout.astro';
import Brand from '../components/Brand.astro';
---
<AppLayout title="Create account — CampusCare">
  <main class="auth-page">
    <div class="auth-brand"><Brand /></div>
    <section class="auth-card">
      <p class="eyebrow">JOIN YOUR CAMPUS</p>
      <h1>Create your account</h1>
      <p class="auth-subtitle">Use your university details to get started.</p>
      <form id="register-form">
        <label>Full name<input name="name" required autocomplete="name" placeholder="Your full name" /></label>
        <label>Student ID<input name="id" required placeholder="Your student ID" /></label>
        <label>University email<input name="email" type="email" required autocomplete="email" placeholder="you@university.edu" /></label>
        <label>Password<input name="password" type="password" required minlength="8" autocomplete="new-password" placeholder="At least 8 characters" /></label>
        <p class="form-error" id="error" role="alert"></p>
        <button class="primary-button" type="submit">Create account</button>
      </form>
      <p class="auth-footer">Already registered? <a href="/login">Sign in</a></p>
    </section>
  </main>
  <script is:inline>
    document.querySelector('#register-form').addEventListener('submit', async event => {
      event.preventDefault();
      const values = new FormData(event.currentTarget), state = CampusCare.getState();
      const email = String(values.get('email')).trim().toLowerCase(), id = String(values.get('id')).trim();
      const name=String(values.get('name')).trim(),password=String(values.get('password')),error=document.querySelector('#error');error.textContent='';
      try {
        if(await CampusStudent.backendReady()) {
          const data=await CampusAdmin.request('/auth/register','POST',{name,studentId:id,email,password});state.user=data.user;state.mode='api';
        } else throw Error('The database is not configured yet.');
        CampusCare.saveState(state);location.href='/';
      } catch(cause){error.textContent=cause.message||'Registration failed.'}
    });
  </script>
</AppLayout>
