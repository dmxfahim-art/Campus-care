---
import AppLayout from '../layouts/AppLayout.astro'; import Sidebar from '../components/Sidebar.astro';
---
<AppLayout title="Notifications — CampusCare"><div class="app-shell"><Sidebar active="notifications"/><main class="main-content"><header class="topbar"><div class="breadcrumb"><span>Student portal</span><b>/</b> Notifications</div></header><section class="page-content form-page"><h1>Notifications</h1><button class="secondary-button" id="mark-all">Mark all as read</button><section class="notice-card notifications-panel" id="notification-list"></section></section></main></div><script is:inline>const state=CampusCare.getState(),list=document.querySelector('#notification-list');function render(){list.innerHTML=state.notifications.map(n=>`<div class="notification-row"><div class="notice-dot">${n.read?'✓':'●'}</div><div><strong>${CampusCare.escapeHtml(n.text)}</strong><small>${CampusCare.escapeHtml(n.time)} · ${n.read?'Read':'Unread'}</small></div><button class="secondary-button" data-id="${n.id}">${n.read?'Mark unread':'Mark read'}</button></div>`).join('')||'<div class="empty-state">No notifications yet.</div>';list.querySelectorAll('[data-id]').forEach(b=>b.onclick=()=>{const n=state.notifications.find(x=>String(x.id)===b.dataset.id);n.read=!n.read;CampusCare.saveState(state);render()})}document.querySelector('#mark-all').onclick=()=>{state.notifications.forEach(n=>n.read=true);CampusCare.saveState(state);render()};render();</script></AppLayout>
