---
import AppLayout from '../layouts/AppLayout.astro'; import Sidebar from '../components/Sidebar.astro';
---
<AppLayout title="My profile — CampusCare"><div class="app-shell"><Sidebar /><main class="main-content"><header class="topbar"><div class="breadcrumb"><span>Student portal</span><b>/</b> My profile</div></header><section class="page-content form-page"><p class="eyebrow">ACCOUNT</p><h1>My profile</h1><p class="subtitle">Update the details used on your CampusCare account.</p><form class="form-card" id="profile-form"><label>Full name<input name="name" required /></label><label>Student ID<input name="id" required /></label><label>Email<input name="email" type="email" required /></label><div class="form-actions"><a class="secondary-button" href="/">Cancel</a><button class="primary-button" type="submit">Save changes →</button></div><p class="form-success" id="success" hidden>Profile saved locally.</p></form></section></main></div><script is:inline>const profileState=CampusCare.getState(),profileForm=document.querySelector('#profile-form');if(profileState.user){profileForm.elements.namedItem('name').value=profileState.user.name||'';profileForm.elements.namedItem('id').value=profileState.user.id||'';profileForm.elements.namedItem('email').value=profileState.user.email||''}profileForm.addEventListener('submit',e=>{e.preventDefault();const f=new FormData(profileForm),oldId=profileState.user.id,oldEmail=profileState.user.email,email=String(f.get('email')).trim().toLowerCase(),id=String(f.get('id')).trim();if(profileState.users.some(u=>u.id!==oldId&&(u.id===id||u.email.toLowerCase()===email))){document.querySelector('#success').textContent='Student ID or email is already in use.';document.querySelector('#success').hidden=false;return}const updated={...profileState.user,name:String(f.get('name')).trim(),id,email};profileState.users=profileState.users.map(u=>u.id===oldId&&u.email===oldEmail?{...u,...updated}:u);profileState.complaints.forEach(c=>{if(c.student===profileState.user.name)c.student=updated.name});profileState.user=updated;CampusCare.saveState(profileState);document.querySelector('#success').textContent='Profile saved locally.';document.querySelector('#success').hidden=false});</script></AppLayout>
