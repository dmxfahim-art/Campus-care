---
import AppLayout from '../../layouts/AppLayout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
---
<AppLayout title="Support requests — CampusCare"><div class="app-shell"><AdminSidebar active="support" /><main class="main-content"><header class="topbar"><div class="breadcrumb"><span>Admin portal</span><b>/</b> Support</div></header><section class="page-content form-page"><p class="eyebrow">STUDENT SUPPORT</p><h1>Support requests</h1><p class="subtitle">Review messages and send replies without showing student identities.</p><div id="support-list"></div><div class="form-actions"><button class="secondary-button" id="previous" type="button">Previous</button><span id="page-label"></span><button class="secondary-button" id="next" type="button">Next</button></div><p class="form-error" id="support-error" role="alert"></p></section></main></div><script is:inline>
  const escape=CampusCare.escapeHtml,list=document.querySelector('#support-list'),errorBox=document.querySelector('#support-error');let page=1,total=0;
  async function render(){try{const result=await CampusAdmin.support(page);total=result.total;list.innerHTML=result.items.map(r=>`<form class="form-card" data-request="${escape(r.id)}"><h2>${escape(r.subject)}</h2><small>${escape(String(r.createdAt).slice(0,10))}</small><p>${escape(r.message)}</p><label>Status<select name="status"><option ${r.status==='Open'?'selected':''}>Open</option><option ${r.status==='In Progress'?'selected':''}>In Progress</option><option ${r.status==='Resolved'?'selected':''}>Resolved</option></select></label><label>Reply<textarea name="reply" rows="4" maxlength="2000">${escape(r.reply||'')}</textarea></label><button class="primary-button">Save and notify student</button><p role="status"></p></form>`).join('')||'<p class="empty-state">No support requests have been submitted. Requests sent from the student Help & support page will appear here.</p>';document.querySelector('#page-label').textContent=`Page ${page} · ${total} requests`;document.querySelector('#previous').disabled=page<=1;document.querySelector('#next').disabled=page*20>=total;list.querySelectorAll('[data-request]').forEach(form=>form.onsubmit=async event=>{event.preventDefault();const button=form.querySelector('button'),message=form.querySelector('[role="status"]'),data=new FormData(form);button.disabled=true;message.textContent='Saving…';try{await CampusAdmin.updateSupport(form.dataset.request,String(data.get('status')),String(data.get('reply')).trim());message.textContent='Saved. The student has been notified.'}catch(error){message.textContent=error.message}finally{button.disabled=false}})}catch(error){errorBox.textContent=error.message}}
  document.querySelector('#previous').onclick=()=>{page--;render()};document.querySelector('#next').onclick=()=>{page++;render()};render();
</script></AppLayout>
