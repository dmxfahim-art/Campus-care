---
import AppLayout from '../../layouts/AppLayout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
---
<AppLayout title="Admin overview — CampusCare"><div class="app-shell"><AdminSidebar active="overview" /><main class="main-content"><header class="topbar"><div class="breadcrumb"><span>Admin portal</span><b>/</b> Overview</div></header><section class="page-content"><p class="eyebrow">CAMPUS OPERATIONS</p><h1>Complaint overview</h1><p class="subtitle">Track issues across campus without exposing who reported them.</p><div class="stats-grid" id="admin-stats"></div><div class="help-grid admin-breakdowns"><article class="detail-card"><h2>By category</h2><div id="by-category"></div></article><article class="detail-card"><h2>By department</h2><div id="by-department"></div></article></div><div class="section-heading"><div><h2>Recent complaints</h2><p>Assign departments and keep issues moving.</p></div><a href="/admin/complaints">View all</a></div><div class="complaints-card" id="admin-recent"></div><p class="form-error" id="admin-error" role="alert"></p></section></main></div><script is:inline>
  const escape=CampusCare.escapeHtml;
  const breakdown=(target,values,total)=>{document.querySelector(target).innerHTML=Object.entries(values||{}).map(([name,count])=>`<div class="breakdown-row"><div><strong>${escape(name)}</strong><span>${count}</span></div><div class="breakdown-track"><i style="width:${total?Math.round(count/total*100):0}%"></i></div></div>`).join('')||'<p class="subtitle">No data yet.</p>'};
  (async()=>{try{const [summary,result]=await Promise.all([CampusAdmin.summary(),CampusAdmin.complaints(1)]);const scope=CampusCare.getState().user.role==='admin'?'Campus wide':'Assigned department';const counts=[['Total complaints',summary.total,'▤'],['In progress',summary.inProgress,'◷'],['Resolved',summary.resolved,'✓']];document.querySelector('#admin-stats').innerHTML=counts.map(([label,count,icon])=>`<article class="stat-card"><div class="stat-icon">${icon}</div><div><span>${label}</span><strong>${count}</strong><small>${scope}</small></div></article>`).join('');breakdown('#by-category',summary.byCategory,summary.total);breakdown('#by-department',summary.byDepartment,summary.total);document.querySelector('#admin-recent').innerHTML=result.items.slice(0,5).map(c=>`<a class="complaint-link" href="/admin/complaint?id=${encodeURIComponent(c.id)}"><div class="table-row"><div class="complaint-name"><div class="complaint-icon">▤</div><div><strong>${escape(c.title)}</strong><small>${escape(c.displayId)} · ${escape(c.location)}</small></div></div><span class="category">${escape(c.category)}</span><span class="status ${c.status.toLowerCase().replace(' ','-')}"><i></i>${escape(c.status)}</span><span class="date">${escape(c.createdAt)}</span><span>→</span></div></a>`).join('')||'<p class="empty-state">No complaints yet.</p>'}catch(error){document.querySelector('#admin-error').textContent=error.message}})();
</script></AppLayout>
