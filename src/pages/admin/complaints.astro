---
import AppLayout from '../../layouts/AppLayout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
---
<AppLayout title="Admin complaints — CampusCare"><div class="app-shell"><AdminSidebar active="complaints" /><main class="main-content"><header class="topbar"><div class="breadcrumb"><span>Admin portal</span><b>/</b> Complaints</div></header><section class="page-content"><p class="eyebrow">ANONYMOUS REPORTS</p><h1>All complaints</h1><p class="subtitle">Review reports by complaint number, category, and location.</p><div class="filter-bar" id="admin-filters"><button class="filter active" data-filter="All">All</button><button class="filter" data-filter="Submitted">Submitted</button><button class="filter" data-filter="In Progress">In progress</button><button class="filter" data-filter="Resolved">Resolved</button></div><div class="complaints-card" id="admin-list"></div><div class="pager"><button class="secondary-button" id="previous-page" disabled>← Previous</button><span id="page-label"></span><button class="secondary-button" id="next-page" disabled>Next →</button></div><p class="form-error" id="admin-error" role="alert"></p></section></main></div><script is:inline>
  const escape=CampusCare.escapeHtml,list=document.querySelector('#admin-list');let page=1,filter='All';
  async function render(){try{const result=await CampusAdmin.complaints(page,filter);list.innerHTML=result.items.map(c=>`<a class="complaint-link" href="/admin/complaint?id=${encodeURIComponent(c.id)}"><div class="table-row"><div class="complaint-name"><div class="complaint-icon">▤</div><div><strong>${escape(c.title)}</strong><small>${escape(c.displayId)} · ${escape(c.location)}</small></div></div><span class="category">${escape(c.category)}</span><span class="status ${c.status.toLowerCase().replace(' ','-')}"><i></i>${escape(c.status)}</span><span class="date">${escape(c.createdAt)}</span><span>→</span></div></a>`).join('')||'<p class="empty-state">No complaints in this view.</p>';const pages=Math.max(1,Math.ceil(result.total/20));document.querySelector('#page-label').textContent='Page '+page+' of '+pages;document.querySelector('#previous-page').disabled=page<=1;document.querySelector('#next-page').disabled=page>=pages}catch(error){document.querySelector('#admin-error').textContent=error.message}}render();
  document.querySelectorAll('#admin-filters button').forEach(button=>button.onclick=()=>{document.querySelectorAll('#admin-filters button').forEach(b=>b.classList.remove('active'));button.classList.add('active');filter=button.dataset.filter;page=1;render()});document.querySelector('#previous-page').onclick=()=>{page--;render()};document.querySelector('#next-page').onclick=()=>{page++;render()};
</script></AppLayout>
