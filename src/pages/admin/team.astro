---
import AppLayout from '../../layouts/AppLayout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
---
<AppLayout title="Admin team — CampusCare"><div class="app-shell"><AdminSidebar active="team" /><main class="main-content"><header class="topbar"><div class="breadcrumb"><span>Admin portal</span><b>/</b> Team</div></header><section class="page-content form-page"><p class="eyebrow">ACCESS MANAGEMENT</p><h1>Team</h1><p class="subtitle">Create access for administrators and department staff.</p><div class="detail-card notifications-panel" id="team-list"></div><form class="form-card" id="team-form"><h2>Add a team member</h2><label>Full name<input name="name" required /></label><label>Email<input name="email" type="email" required /></label><label>Account ID<input name="id" required /></label><label>Role<select name="role" id="team-role"><option value="staff">Department staff</option><option value="admin">Administrator</option></select></label><label id="department-field">Department<select name="departmentId" id="team-department"></select></label><label>Temporary password<input name="password" type="password" minlength="8" required /></label><button class="primary-button">Create account</button><p class="form-error" id="team-result" role="status"></p></form></section></main></div><script is:inline>
  const escape=CampusCare.escapeHtml,form=document.querySelector('#team-form'),message=document.querySelector('#team-result');let departments=[];
  async function render(){const items=await CampusAdmin.team();document.querySelector('#team-list').innerHTML=items.map(u=>`<form class="team-member" data-member-id="${escape(u.id)}"><div class="account-identity"><div class="notice-dot">${escape(u.name[0])}</div><div><strong>${escape(u.name)}</strong><small>${escape(u.email)}</small></div></div><div class="team-controls"><label>Role<select name="role"><option value="staff" ${u.role==='staff'?'selected':''}>Department staff</option><option value="admin" ${u.role==='admin'?'selected':''}>Administrator</option></select></label><label>Department<select name="departmentId"><option value="">None</option>${departments.map(d=>`<option value="${escape(d.code)}" ${u.departmentId===d.code?'selected':''}>${escape(d.name)}</option>`).join('')}</select></label><label>Status<select name="active"><option value="true" ${u.active!==false?'selected':''}>Active</option><option value="false" ${u.active===false?'selected':''}>Disabled</option></select></label><button class="secondary-button">Save</button></div><p class="form-error" role="status"></p></form>`).join('')||'<p>No team members yet.</p>';document.querySelectorAll('[data-member-id]').forEach(member=>member.onsubmit=async e=>{e.preventDefault();const f=new FormData(member),result=member.querySelector('[role="status"]'),button=member.querySelector('button');button.disabled=true;try{await CampusAdmin.updateTeam(member.dataset.memberId,{role:String(f.get('role')),departmentId:String(f.get('departmentId'))||null,active:f.get('active')==='true'});result.textContent='Saved.'}catch(error){result.textContent=error.message}finally{button.disabled=false}})}
  (async()=>{try{departments=await CampusAdmin.departments();document.querySelector('#team-department').innerHTML=departments.map(d=>`<option value="${escape(d.code)}">${escape(d.name)}</option>`).join('');await render()}catch(error){message.textContent=error.message}})();
  document.querySelector('#team-role').onchange=e=>{document.querySelector('#department-field').hidden=e.target.value!=='staff'};
  form.onsubmit=async e=>{e.preventDefault();const f=new FormData(form),button=form.querySelector('button');button.disabled=true;message.textContent='Creating account…';try{const input={name:String(f.get('name')).trim(),email:String(f.get('email')).trim().toLowerCase(),studentId:String(f.get('id')).trim(),role:String(f.get('role')),departmentId:f.get('role')==='staff'?String(f.get('departmentId')):undefined,password:String(f.get('password'))};await CampusAdmin.createTeam(input);form.reset();document.querySelector('#department-field').hidden=false;message.textContent='Account created.';await render()}catch(error){message.textContent=error.message}finally{button.disabled=false}};
</script></AppLayout>
